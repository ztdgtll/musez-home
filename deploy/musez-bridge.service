[Unit]
Description=MuseZ bridge daemon (studio listener queue -> live bridge turns)
After=network.target
Documentation=file:///home/hatch/workspace/hackathon-meta-2026/musez-home/bridge/daemon.py

[Service]
Type=simple
# No User= line: this VM's shell user IS root, and its home is
# /home/hatch by convention (the repo, the ssh config and the keys
# all live there). HOME is pinned so expanduser() in the bridge
# resolves the same paths the interactive shell uses.
Environment=HOME=/home/hatch
# Optional per-host secrets (e.g. the Voice Monkey trigger URL for
# call_astro). The file lives OUTSIDE the repo with mode 600; the
# leading dash makes it optional so the service still starts
# without it (the tool then honestly reports itself unavailable).
EnvironmentFile=-/home/hatch/.musez-astro.env
# The ssh ProxyCommand helper (Tailscale tunnel to the Pi)
# reads the proxy from the environment; the interactive
# shell has it, a bare systemd service does not.
Environment="HTTPS_PROXY=http://hatch-runtime:85913be30ef042d284b3462b731607d7@hatch-egress-proxy:3128"
Environment="https_proxy=http://hatch-runtime:85913be30ef042d284b3462b731607d7@hatch-egress-proxy:3128"
Environment="HTTP_PROXY=http://hatch-runtime:85913be30ef042d284b3462b731607d7@hatch-egress-proxy:3128"
Environment="http_proxy=http://hatch-runtime:85913be30ef042d284b3462b731607d7@hatch-egress-proxy:3128"
Environment="ALL_PROXY=http://hatch-runtime:85913be30ef042d284b3462b731607d7@hatch-egress-proxy:3128"
Environment="all_proxy=http://hatch-runtime:85913be30ef042d284b3462b731607d7@hatch-egress-proxy:3128"
Environment="NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]"
Environment="no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2,fd8b:4f84:7d32:99::1,[fd8b:4f84:7d32:99::1],fd8b:4f84:7d32:99::2,[fd8b:4f84:7d32:99::2]"
WorkingDirectory=/home/hatch/workspace/hackathon-meta-2026/musez-home
ExecStart=/usr/bin/python3 -m bridge.daemon
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
